{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "name_key",
    "tags",
    "components",
    "visual"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"
    },
    "kind": {
      "enum": [
        "block",
        "item",
        "resource",
        "structure",
        "creature",
        "machine"
      ]
    },
    "name_key": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "core:stackable": {
          "type": "object",
          "required": [
            "max_count"
          ],
          "properties": {
            "max_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "core:harvestable": {
          "type": "object",
          "required": [
            "duration_ticks",
            "drops",
            "tool_tags"
          ],
          "properties": {
            "duration_ticks": {
              "type": "integer",
              "minimum": 1
            },
            "drops": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "def_id",
                  "count"
                ],
                "properties": {
                  "def_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "tool_tags": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"
              }
            }
          }
        },
        "core:craft_station": {
          "type": "object",
          "required": [
            "station_tags",
            "queue_limit"
          ],
          "properties": {
            "station_tags": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"
              }
            },
            "queue_limit": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "core:placeable": {
          "type": "object",
          "required": [
            "footprint",
            "rotation_steps"
          ],
          "properties": {
            "footprint": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "rotation_steps": {
              "enum": [
                1,
                2,
                4,
                8
              ]
            }
          }
        },
        "core:world_resource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius",
            "biomes",
            "render_kind"
          ],
          "properties": {
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "biomes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "meadow",
                  "forest",
                  "rocky"
                ]
              }
            },
            "render_kind": {
              "enum": [
                "tree",
                "rock"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "visual": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "primitive",
            "asset",
            "procedural"
          ]
        },
        "shape": {
          "enum": [
            "box",
            "sphere",
            "cylinder",
            "none"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"
        },
        "generator_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"
        }
      }
    }
  }
}
